{
  "$schema": "../scenario.schema.json",
  "name": "04-self-check-limits",
  "description": "The self-check warns when a node or the whole turn declares more names than the SDK attribute count limit, and when a declared maxLength is over the value size limit. With a tracer provider and no logger provider, the check fails only when a logger provider is required.",
  "covers": [
    "practice 4: selfCheck() warns when a node or the turn declares more names than the SDK attribute count limit, and stays ok",
    "practice 4: selfCheck() warns when a declared maxLength exceeds the value size limit, 8192 by default, or valueSizeLimit",
    "practice 4: init() writes each warning to the console as a warning",
    "practice 4: the start-up span carries flywheel.self_check.ok and the issue codes",
    "practice 4: with requireLoggerProvider or azureCustomEvents, selfCheck() fails with no_logger_provider, and with neither the logger provider is optional"
  ],
  "setup": {
    "clock": "2026-10-01T00:00:00.000Z",
    "tracerProvider": true,
    "loggerProvider": false,
    "attributeCountLimit": 20,
    "sampler": "always_on"
  },
  "steps": [
    {
      "op": "init",
      "options": {
        "schemas": {
          "agent": {
            "wide": {
              "attributes": {
                "k00": { "type": "count" }, "k01": { "type": "count" }, "k02": { "type": "count" }, "k03": { "type": "count" },
                "k04": { "type": "count" }, "k05": { "type": "count" }, "k06": { "type": "count" }, "k07": { "type": "count" },
                "k08": { "type": "count" }, "k09": { "type": "count" }, "k10": { "type": "count" }, "k11": { "type": "count" },
                "k12": { "type": "count" }, "k13": { "type": "count" }, "k14": { "type": "count" }, "k15": { "type": "count" },
                "k16": { "type": "count" }, "k17": { "type": "count" }, "k18": { "type": "count" }, "k19": { "type": "count" },
                "k20": { "type": "count" }
              }
            }
          },
          "tool": { "a": { "attributes": { "k0": { "type": "count" } } } },
          "model": {
            "analysis": {
              "attributes": {
                "answer": { "type": "string", "maxLength": 10000 },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    {
      "op": "init",
      "options": {
        "valueSizeLimit": 1000,
        "schemas": {
          "model": {
            "analysis": {
              "attributes": {
                "answer": { "type": "string", "maxLength": 10000 },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    { "op": "selfCheck" },
    { "op": "init", "options": { "requireLoggerProvider": true } },
    { "op": "init", "options": { "azureCustomEvents": true } },
    { "op": "selfCheck" },
    { "op": "init" },
    { "op": "selfCheck" }
  ]
}
